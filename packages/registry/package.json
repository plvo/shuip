{
  "name": "@repo/registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./__index__": "./__index__.ts",
    "./__index__.base": "./generated/base/__index__.ts",
    "./example-key": "./src/example-key.ts",
    "./item-source": "./src/item-source.ts",
    "./namespace": "./src/namespace.ts",
    "./registry-file": "./src/registry-file.ts",
    "./rewrite-match": "./src/rewrite-match.ts",
    "./style-base": "./src/style-base.ts",
    "./items/*": "./items/*",
    "./stubs/*": "./stubs/*"
  },
  "scripts": {
    "registry:generate": "bun run scripts/generate.ts",
    "typecheck:base": "bun run scripts/generate.ts && tsc --noEmit -p items",
    "typecheck:radix": "bun run scripts/generate.ts && tsc --noEmit -p .",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:forms",
    "@hookform/resolvers": "catalog:forms",
    "@hookform/lenses": "catalog:forms",
    "@tanstack/react-form": "catalog:forms",
    "@tanstack/react-query": "catalog:forms",
    "@tanstack/react-table": "catalog:",
    "react-error-boundary": "catalog:forms",
    "zod": "catalog:",
    "date-fns": "catalog:",
    "react-day-picker": "catalog:",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "lucide-react": "catalog:",
    "@repo/ui": "workspace:*",
    "@base-ui/react": "catalog:",
    "cmdk": "catalog:",
    "next-themes": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@repo/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "next": "catalog:",
    "typescript": "catalog:"
  }
}
